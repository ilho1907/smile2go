# ════════════════════════════════════════════════════
# smile2go — Konfiguration (.env)
# NIEMALS ins Git-Repository committen! (.gitignore)
# Alle Keys hier eintragen — der Code liest nur aus ENV.
# ════════════════════════════════════════════════════

# ── KI (LUMA, Orakel-Deutung, Horoskop, Tagescontent) ──
# Quelle: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Supabase (Auth, Datenbank, Storage — Region: EU/Frankfurt!) ──
# Quelle: supabase.com → Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # nur Server/n8n, NIE im Frontend!

# ── Google OAuth (Login + Kalender-Sync) ──
# Quelle: console.cloud.google.com → Credentials → OAuth 2.0
# Scopes: openid, email, profile, calendar.readonly
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# ── Stripe (Abos: Starter 29 € / Pro 49 € / Business 99 €) ──
# Quelle: dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_BUSINESS=price_...

# ── Push-Benachrichtigungen (PWA Web-Push, 07:00) ──
# Quelle: onesignal.com → Settings → Keys & IDs
ONESIGNAL_APP_ID=...
ONESIGNAL_API_KEY=...

# ── Wetter (Heute-Widget) ──
# Open-Meteo: KEIN Key nötig (kostenlos, DSGVO-freundlich)
# https://api.open-meteo.com/v1/forecast?latitude=48.14&longitude=11.58
WETTER_STADT=München
WETTER_LAT=48.1374
WETTER_LON=11.5755

# ── Video-Pipeline (ilhoVA: vidio.ai → Reap → Eden AI → Claude → Blotato) ──
VIDIO_AI_API_KEY=...
REAP_API_KEY=...
EDEN_AI_API_KEY=...
BLOTATO_API_KEY=...

# ── Webflow (Plattform-Verknüpfung) ──
WEBFLOW_SITE_ID=69f10441f1067e717d9cdc00
WEBFLOW_API_TOKEN=...

# ── n8n ──
N8N_WEBHOOK_BASE=https://n8n.deine-domain.de
