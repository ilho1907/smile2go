# Smile2Go Website – Umgebungsvariablen (Datei als .env.local kopieren)
# Alles mit VITE_ landet im Browser. NIE Geheimnisse hier eintragen.

# Adresse der App für "Login"-Links (Standard: bestehende App)
VITE_APP_URL=https://smile2go-app.vercel.app

# Server-Endpunkt für Formulare. LEER = Demo-Modus (nichts wird gesendet).
# Erst eintragen, wenn Endpunkt, AVV und Datenschutztext stehen (Phase 2/3).
VITE_FORMULAR_ENDPUNKT=

# Suchmaschinen-Indexierung. Nur "ja" nach ausdrücklicher Freigabe durch ilho.
VITE_SITE_INDEXIERBAR=nein
