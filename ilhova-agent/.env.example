# Kopiere diese Datei nach .env und trage die echten Werte ein. .env wird NIE committet.

# Anthropic API-Schlüssel – wird ausschließlich hier (.env) gelesen.
ANTHROPIC_API_KEY=

# Gemeinsamer Schlüssel, den smile2go im Header "x-api-key" mitschickt (POST /chat).
# Erzeugen z. B. mit: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ILHOVA_SERVICE_KEY=

# Optional
PORT=8787
# 127.0.0.1 = nur lokal. Für den Betrieb hinter einem TLS-Proxy/Reverse-Proxy anpassen.
HOST=127.0.0.1
# Maximale Dauer eines Chat-Turns in Sekunden
TURN_TIMEOUT_SECONDS=120
# Zeitzone, in der Erinnerungen formuliert werden
CLIENT_TIMEZONE=Europe/Berlin
